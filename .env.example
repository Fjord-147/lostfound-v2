# 数据库连接（本地示例；生产由运维注入，禁止提交真实值到 Git）
DATABASE_URL="postgresql://lostfound:lostfound@localhost:5432/lostfound"

# JWT 签名密钥（生产必须换成随机长串：openssl rand -hex 32）
JWT_SECRET="change-me-to-a-long-random-string"

# 初始管理员（首次 seed 用；SSO 接入后此账号体系可停用）
SEED_USERNAME="liumin"
SEED_PASSWORD="liumin123"
SEED_NAME="刘敏"

# 服务端口
API_PORT=8000
